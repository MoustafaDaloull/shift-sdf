# =============================================================================
# {{PROJECT_NAME}} — Docker environment template
# -----------------------------------------------------------------------------
# Copy to `.env` at the repository root and edit:      make init
#
# `.env` is git-ignored and MUST stay that way. This template is committed; it
# contains placeholders only, never a real credential (no secret in source code
# or Docker images).
#
# SCOPE: this file configures the DOCKER stack. Laravel's own backend/.env is
# deliberately EMPTY in this profile: every application setting reaches the
# container through the environment blocks in docker/compose/*.yaml, which read
# this file. One source, not two.
# =============================================================================

# -----------------------------------------------------------------------------
# PROJECT IDENTITY
# -----------------------------------------------------------------------------
# Prefixes every container, network, and volume name. Change it only if you run
# several checkouts of this repository side by side — changing it points the
# stack at a different set of volumes, which reads as "my database is empty".
#
# Isolated agent worktrees get exactly that on purpose: the worktree tool
# provisions the tree's .env with a unique project name and a port slot
# (PORT_SLOT), so each writer tree drives its own stack and the quality gates
# can run concurrently without colliding.
COMPOSE_PROJECT_NAME={{PROJECT_SLUG}}

# One zone across every container so log timestamps line up. MySQL stores data
# in UTC regardless; this affects display and logging only.
TZ=UTC

# -----------------------------------------------------------------------------
# HOST USER MAPPING  (Linux / WSL2)
# -----------------------------------------------------------------------------
# Files created inside a container are owned by this uid on the host. Set these
# to your own ids so bind-mounted files stay editable without sudo:
#     id -u   ->  APP_UID
#     id -g   ->  APP_GID
# On Docker Desktop for Windows with the repository on a Windows drive the
# values are ignored by the filesystem bridge — leave the defaults.
# CI sets them to the runner's identity (ci.yml) — the runner is 1001, not 1000.
APP_USER=app
APP_UID=1000
APP_GID=1000

# -----------------------------------------------------------------------------
# IMAGE VERSIONS
# -----------------------------------------------------------------------------
# Pinned to exact patch versions, not floating tags. A `mysql:8.4` tag silently
# moves under you and makes a build non-reproducible; an exact tag means the
# image you tested is the image that ships. Bump these deliberately.
PHP_VERSION=8.5.3
NODE_VERSION=22.21
MYSQL_VERSION=8.4.7
REDIS_VERSION=8.2-alpine
NGINX_VERSION=1.29
MAILPIT_VERSION=v1.28

# -----------------------------------------------------------------------------
# PUBLISHED PORTS (host side)
# -----------------------------------------------------------------------------
# Change any of these if the port is already taken on your machine. Only the
# host side moves; nothing inside the containers changes.
NGINX_PORT=8080
VITE_PORT=5173
MYSQL_PORT=3306
# Two Redis instances: 6379 = queue + sessions, 6380 = cache. These are HOST
# ports; the in-network port the app dials is always 6379 (REDIS_PORT /
# REDIS_CACHE_PORT below are NOT these — see compose.dev.yaml for why the two
# were split).
REDIS_HOST_PORT=6379
REDIS_CACHE_HOST_PORT=6380
MAILPIT_UI_PORT=8025

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
# The public origin of the SPA, when the API needs to build links back to it
# (e-mail links, OAuth redirects). Empty = not used.
FRONTEND_URL=

# Laravel's encryption key: sessions, cookies, signed URLs, encrypted columns.
# Without it the first request touching any of those throws — the application
# does not degrade, it stops.
#
# The value below is a DUMMY, published in this template on purpose and safe
# only because it is published: it is in every clone, so it protects nothing and
# must never reach a real environment. Production takes its key from the secret
# manager (compose.prod.yaml refuses to start without it).
#
# Generate your own for local work — the key is what decrypts your sessions, and
# sharing one across machines is how a "works on my machine" cookie bug is born:
#
#     docker compose ... exec php php artisan key:generate --show
#
# The decoded value must be EXACTLY 32 bytes: the default cipher is AES-256-CBC
# and Laravel rejects any other length with "Unsupported cipher or incorrect
# key length" — a message that names the cipher and so reads as a config error
# rather than a key-length one.
APP_KEY=base64:ZHVtbXkta2V5LWZvci1sb2NhbC1kZXYtb25seS0wMDA=

# The origin the React SPA calls. Vite bakes VITE_* variables into the bundle at
# BUILD time, so anything here is publicly visible in the shipped JavaScript —
# never put a secret behind a VITE_ prefix.
VITE_API_BASE_URL=http://localhost:8080

# Demonstration data on every `migrate --seed` (development stack only).
APP_DEMO_SEED=false

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
MYSQL_DATABASE={{PROJECT_SLUG}}
MYSQL_USER={{PROJECT_SLUG}}
# Created automatically on first boot by docker/mysql/initdb/01-init-databases.sh
MYSQL_TEST_DATABASE={{PROJECT_SLUG}}_test

# >>> CHANGE BOTH OF THESE BEFORE FIRST RUN <<<
# They are only ever reachable from the internal Docker network in this setup,
# but a weak local password becomes a real production password the day someone
# copies this file to a server. Generate them: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_PASSWORD=change_me_app_password

# -----------------------------------------------------------------------------
# REDIS — two instances
# -----------------------------------------------------------------------------
# `redis`       queue + sessions — noeviction, persisted. Losing this is a bug.
# `redis-cache` cache + rate limits — allkeys-lru, ephemeral. Losing this is fine.
#
# They are separated so that cache growth can never evict a queued payment job.
# Both share one password locally; production uses two secret-manager entries.
#
# >>> CHANGE THIS BEFORE FIRST RUN <<<
# An unauthenticated Redis is one of the most reliably exploited services on the
# internet — the password is not optional even locally.
REDIS_PASSWORD=change_me_redis_password

# Hostnames inside the Docker network. Override only if pointing at an external
# Redis. Setting both to the same host defeats the separation.
REDIS_HOST=redis
REDIS_CACHE_HOST=redis-cache
# In-network ports (what the app dials). Not the host ports above.
REDIS_PORT=6379
REDIS_CACHE_PORT=6379

# -----------------------------------------------------------------------------
# MAIL (development)
# -----------------------------------------------------------------------------
# Mailpit captures everything and delivers nothing. See docker/mailpit/README.md.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAILPIT_MAX_MESSAGES=500

# -----------------------------------------------------------------------------
# PHP-FPM POOL
# -----------------------------------------------------------------------------
# `dynamic` scales workers with load, which suits an idle development machine.
# Production overrides this to `static` — see compose.prod.yaml.
PHP_FPM_PM=dynamic
PHP_FPM_MAX_CHILDREN=20
PHP_FPM_START_SERVERS=4
PHP_FPM_MIN_SPARE=2
PHP_FPM_MAX_SPARE=6

# -----------------------------------------------------------------------------
# XDEBUG
# -----------------------------------------------------------------------------
#   off       default — extension loaded but inert, negligible overhead
#   develop   better var_dump and error messages
#   debug     step debugging (IDE must be listening on port 9003)
#   coverage  required for `php artisan test --coverage`
# Prefer setting this per command rather than here:
#   docker compose exec -e XDEBUG_MODE=debug php php artisan tinker
XDEBUG_MODE=off

# -----------------------------------------------------------------------------
# FILE WATCHING (Vite HMR)
# -----------------------------------------------------------------------------
# true  — required when the repository sits on a Windows drive, because
#         inotify events do not cross the Docker Desktop filesystem bridge.
# false — correct when the repository lives inside WSL2 (\\wsl$\...), where
#         native events work and polling only wastes CPU.
CHOKIDAR_USEPOLLING=true

# -----------------------------------------------------------------------------
# FRONTEND BROWSER GATES (Playwright inside the node container)
# -----------------------------------------------------------------------------
# The integration project reaches the backend by its Compose service name.
# Leave the default unless the API edge is renamed.
INTEGRATION_API_BASE_URL=http://nginx

# =============================================================================
# PRODUCTION ONLY — leave blank locally
# -----------------------------------------------------------------------------
# These are consumed by compose.prod.yaml. In a real deployment they are NOT
# read from a file: the platform injects them from a secret manager, and this
# block exists only to document what the production stack requires.
# =============================================================================
# IMAGE_REGISTRY=registry.example.com/{{PROJECT_SLUG}}
# IMAGE_TAG=latest
# APP_KEY=                      # php artisan key:generate --show
# APP_URL=
# DB_HOST=                      # managed MySQL private IP, or 127.0.0.1 via a proxy
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=                  # secret manager
# REDIS_HOST=                   # persistent managed Redis
# REDIS_CACHE_HOST=             # cache managed Redis
# REDIS_CACHE_PASSWORD=         # secret manager
# LOG_LEVEL=warning
# QUEUE_REPLICAS=2
# HTTP_PORT=80
# WEB_PORT=8081
