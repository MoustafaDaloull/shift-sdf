# =============================================================================
# shift.env — إعدادات سكربتات Shift SDF (بوابات الجودة وأدوات التنفيذ)
# -----------------------------------------------------------------------------
# يُقرأ هذا الملف بـ`source` من كل سكربت في `scripts/`. صيغته bash خالصة:
#   · كل متغيّر مكتوب بصيغة `: "${VAR:=default}"` — فالقيمة **غير الفارغة** في بيئة
#     الصَدَفة **تغلب** القيمة المكتوبة هنا (مفيد في CI وفي شجرات العمل المعزولة).
#     أما القيمة الفارغة في البيئة فتُعامَل كغياب ويحلّ محلّها الافتراضي؛ فمن أراد
#     تعطيل متغيّر «الفارغ فيه = N/A» (TRACKER_FILE · ADMIN_ROUTE_MAP · …) يجعل
#     الافتراضي **هنا** فارغًا: `: "${TRACKER_FILE:=}"`.
#   · لا تُنفَّذ أوامر هنا — تعريف قيم فقط. سكربت يحتاج أمرًا يكتبه عنده.
#   · المسارات نسبية إلى جذر المستودع ما لم يُذكر خلاف ذلك.
#
# القاعدة الحاكمة: ما هو هنا **إعداد**، وما هو في السكربتات **قاعدة**. تغيير
# قيمة هنا لا يُضعِف بوابة؛ أما إيقاف بوابة (SUSPENDED_GATES) فقرار مُعلَن
# يُسجَّل في سجل القرارات ويُطبع في كل تشغيلة — لا يُسكَت.
# =============================================================================

# ── هوية المشروع ──────────────────────────────────────────────────────────────
# اسم العرض في ترويسات المخرَج (عربي أو إنجليزي — نصّ حرّ).
: "${PROJECT_NAME:=Shift Project}"
# معرّف قصير بحروف صغيرة وأرقام وشرطات فقط — يُستعمل أساسًا لأسماء Docker.
: "${PROJECT_SLUG:=shift}"
# أساس اسم مشروع Compose. الحزمة الرئيسة تحمله كما هو، وحزمة الاختبار تحمل
# `<base>-test`، وكل شجرة عمل معزولة تحمل `<base>-<tree>`.
: "${COMPOSE_PROJECT_BASE:=$PROJECT_SLUG}"

# ── شجرة المستودع ─────────────────────────────────────────────────────────────
: "${BACKEND_DIR:=backend}"
: "${FRONTEND_DIR:=frontend}"
: "${FRONTEND_SRC:=$FRONTEND_DIR/src}"
# المجلد الفرعي داخل FRONTEND_SRC الذي يحمل مجلدًا لكل موديول (مجلد الموديول =
# مجلد توثيقه، كما في modules.tsv).
: "${FRONTEND_MODULES_SUBDIR:=modules}"
: "${DOCS_DIR:=docs}"
# حزم الموديولات: مجلد لكل موديول باسم مجلد التوثيق (العمود الثاني في modules.tsv).
: "${MODULES_DOCS_DIR:=$DOCS_DIR/01-modules}"
# سجل القرارات المعتمدة — مرجع فحص `@covers DEC-*` وأداة decision-sweep.sh.
: "${DECISIONS_FILE:=$DOCS_DIR/00-product/project-decisions.md}"
# مجلد المعايير الهندسية — مرجع فحص `@covers CS-*|RS-*|…`.
: "${STANDARDS_DIR:=$DOCS_DIR/03-development}"
# المتتبع التشغيلي المركزي. فارغًا ⟵ فحوص المتتبع في arch-check.sh تُعلَن N/A.
: "${TRACKER_FILE:=$DOCS_DIR/03-development/implementation/implementation-plan-tracker.md}"
# ملف الحوكمة الجذري الذي يُفحص فيه أن الإحالة إلى ملفات التعليمات بالاسم لا
# برقم الإصدار. فارغًا ⟵ الفحص N/A.
: "${GOVERNANCE_BASELINE_FILE:=PROJECT-BASELINE.md}"
# نمط (ERE) أسماء ملفات التعليمات التي لا يجوز الاستشهاد بها برقم إصدار.
: "${INSTRUCTION_FILE_REGEX:=CLAUDE(-[A-Z0-9]+)?\\.md}"

# ── Docker Compose ───────────────────────────────────────────────────────────
: "${COMPOSE_DIR:=docker/compose}"
: "${COMPOSE_BASE_FILE:=compose.yaml}"
: "${COMPOSE_DEV_FILE:=compose.dev.yaml}"
# حزمة الاختبار المعزولة: قاعدة في tmpfs · شبكة داخلية · اسم مشروع مستقل.
: "${COMPOSE_TEST_FILE:=compose.test.yaml}"
# أسماء الخدمات كما في ملفات Compose.
: "${PHP_SERVICE:=php}"
: "${NODE_SERVICE:=node}"
# خدمتا حزمة الاختبار: الأولى تثبّت الاعتماديات (لها منفذ شبكة)، والثانية تشغّل PHPUnit.
: "${TEST_DEPS_SERVICE:=test-deps}"
: "${TEST_SERVICE:=test}"
# مجلد العمل داخل كل حاوية (حيث يُربط BACKEND_DIR وFRONTEND_DIR).
: "${PHP_WORKDIR:=/var/www/html}"
: "${NODE_WORKDIR:=/app}"

# ── بوابات الجودة — الأدوات والمسارات ─────────────────────────────────────────
# مجلد مخرجات البوابات الكاملة (مُتجاهَل في Git — أضفه إلى .gitignore).
: "${GATE_LOGS_DIR:=$FRONTEND_DIR/gate-logs}"
# مستوى PHPStan **كما يُعلنه phpstan.neon** — يُطبع في اسم البوابة ولا يُمرَّر
# للأمر: تمريره كان سيجعل قيمةً هنا تُخفِّض المستوى بصمت.
: "${PHPSTAN_LEVEL:=8}"
: "${PHPSTAN_MEMORY_LIMIT:=1G}"
: "${DEPTRAC_CONFIG:=deptrac.yaml}"
# عقد OpenAPI الملتزَم (نسبي إلى BACKEND_DIR) ومسار التوليد المؤقت للمقارنة.
: "${OPENAPI_FILE:=openapi.json}"
: "${OPENAPI_GENERATED_PATH:=storage/app/openapi.generated.json}"
# تقرير Clover الذي تكتبه مرحلة الاختبارات وتقرؤه مرحلة التغطية (نسبي إلى BACKEND_DIR).
: "${COVERAGE_REPORT_PATH:=storage/app/coverage.xml}"
# صنف البذر الذي تحتاجه مجموعة التكامل (حسابات فحص إدارية مثلًا). فارغًا ⟵ لا بذر.
# يُكتب بشرطة مائلة عكسية **واحدة** بين المقاطع: App\Modules\X\Infrastructure\Seeders\Y
: "${INTEGRATION_SEEDER:=}"
# عتبة `npm audit` — ثغرة بهذا المستوى أو أعلى تُفشِل البناء (AS-036).
: "${NPM_AUDIT_LEVEL:=high}"

# ── البوابات المُوقفة بقرار ───────────────────────────────────────────────────
# معرّفات مراحل مفصولة بمسافات، من: sync fmt stan arch scenario routes fe-static
# fe-unit fe-e2e fe-visual fe-a11y secrets audit openapi integration tests coverage
#
# SUSPENDED_GATES: تخرج من التسلسل التلقائي، وتُعلَن مُوقفةً في كل تشغيلة،
#   وتعود كلُّها بـ`--include-suspended` أو واحدةً بأمرها المفرد.
# MANUAL_ONLY_GATES: خارج **كل** تسلسل — حتى `--include-suspended` وCI — ولا
#   تعمل إلا بأمرها المفرد. تُعلَن أيضًا في كل تشغيلة.
# الافتراضي في الإطار: لا شيء مُوقف. الإيقاف قرار مُسجَّل يُذكر مرجعه أدناه.
: "${SUSPENDED_GATES:=}"
: "${MANUAL_ONLY_GATES:=}"
# مرجع القرار الذي أوقف البوابات — يُطبع مع كل إعلان إيقاف كي يُعرف مَن ومتى ولماذا.
: "${SUSPENSION_DECISION:=قرار مالك المنتج}"

# ── شجرات العمل المتوازية ────────────────────────────────────────────────────
# أقصى عدد لشجرات العمل الإضافية (الشجرة الرئيسة لا تُعدّ). QG-SYNC تُفشل ما زاد.
: "${MAX_EXTRA_WORKTREES:=3}"
# بادئة فرع كل شجرة: `<prefix><tree-name>`.
: "${WORKTREE_BRANCH_PREFIX:=agent/}"
# الشجرات تُنشأ **خارج** المستودع في `<repo-parent>/<repo-name><suffix>/<tree>`.
: "${WORKTREE_DIR_SUFFIX:=-agents}"
# فتحات المنافذ: الفتحة n تُزيح كل منفذ أساس بمقدار n × WORKTREE_PORT_STEP.
: "${WORKTREE_PORT_SLOTS:=9}"
: "${WORKTREE_PORT_STEP:=10}"
# المنافذ المنشورة على المضيف التي تُزاح لكل شجرة: `KEY:BASE` مفصولة بمسافات.
# منافذ **داخل الشبكة** لا تُدرَج هنا — انظر WORKTREE_FIXED_VARS.
: "${WORKTREE_PORT_VARS:=NGINX_PORT:8080 VITE_PORT:5173 MYSQL_PORT:3306 REDIS_HOST_PORT:6379 REDIS_CACHE_HOST_PORT:6380 MAILPIT_UI_PORT:8025}"
# قيم تُثبَّت كما هي في كل شجرة (`KEY=VAL`): المنافذ التي يطلبها التطبيق داخل
# شبكة Compose ولا يجوز إزاحتها — إزاحتها توجّه التطبيق إلى منفذ لا يُصغي عليه أحد.
: "${WORKTREE_FIXED_VARS:=REDIS_PORT=6379 REDIS_CACHE_PORT=6379}"
# متغيّرات URL تُوجَّه إلى nginx **هذه** الشجرة: `http://localhost:<base+offset>`.
: "${WORKTREE_URL_VARS:=APP_URL VITE_API_BASE_URL}"
: "${WORKTREE_URL_PORT_BASE:=8080}"

# ── مسارات الواجهة (GATE-FE-05 · GATE-FE-06) ─────────────────────────────────
# سجل مسارات بوابة الإدارة: الملف والقسم (القسم للرسائل والإحالة فقط).
# فارغًا ⟵ لا بوابة إدارة، وتُعلَن N/A.
: "${ADMIN_ROUTE_MAP:=$DOCS_DIR/02-design/admin/global-navigation-map.md}"
: "${ADMIN_ROUTE_SECTION:=§10}"
# فضاء مسارات الإدارة — صفُّ عملاء يدّعيه فسادُ سجل.
: "${ADMIN_ROUTE_NAMESPACE:=/admin}"
# سجل مسارات تطبيق العملاء. فارغًا ⟵ لا تطبيق عملاء، وتُعلَن N/A.
: "${CLIENT_ROUTE_MAP:=$DOCS_DIR/00-product/global-navigation-map.md}"
: "${CLIENT_ROUTE_SECTION:=§21}"
# بادئة معرّف الصفّ العامة التي تُجمع بها صفوف **السجلين** (العمود الأول)، وبادئة
# صفوف العملاء الخاصة: صفُّ عملاء يُقرأ بالعامة ولا يبدأ بالخاصة فسادُ سجل.
: "${ROUTE_ROW_PREFIX:=RT-}"
: "${CLIENT_ROUTE_ROW_PREFIX:=RT-CLI-}"
# اسم ملف المسارات الكنسي، والأسماء التي تجمعها البوابة. ملفٌ يعرّف مسارات
# باسم آخر يُرصد خرقًا (لا يمرّ صامتًا).
: "${ROUTE_FILE_NAME:=routes.tsx}"
: "${ROUTE_FILE_NAMES:=routes.tsx routes.ts}"
# حالات الصفوف التي يجوز بناء كود عليها. ما عداها مستثنى بنصّ القرار.
: "${ROUTE_ALLOWED_STATUSES:=APPROVED}"
# رقم عمود الموديول المالك في صفّ السجل (الخلايا تُعدّ من 1 بعد الشَرطة الأولى).
: "${ROUTE_OWNER_COLUMN:=5}"
# قيم عمود المالك التي تعني «مسار نظام» يعيش في src/app/ لا في مجلد موديول.
: "${ROUTE_SYSTEM_OWNER_LABELS:=نظام system}"

# ── تغطية السيناريوهات (AS-035) ──────────────────────────────────────────────
# معرّف السيناريو: `<PREFIX>-<CODE>-NNN` حيث CODE كود موديول بحروف كبيرة.
: "${SCENARIO_ID_PREFIX:=TS}"
: "${MODULE_CODE_MIN:=2}"
: "${MODULE_CODE_MAX:=6}"
: "${SCENARIO_TAG:=@scenario}"
: "${COVERS_TAG:=@covers}"
: "${TEST_SCENARIOS_FILE:=test-scenarios.md}"
: "${BACKEND_TESTS_DIR:=$BACKEND_DIR/tests}"
: "${FRONTEND_TESTS_DIR:=$FRONTEND_DIR/tests}"

# ── عتبات التغطية (AS-034) — بالنطاق لا إجماليًا ─────────────────────────────
: "${COVERAGE_GENERAL_MIN:=70}"
# منطق الأعمال: ملفات `/Application/Services/`.
: "${COVERAGE_SERVICES_MIN:=85}"
# الموديولات المالية: مجلدات كود مفصولة بـ`|` (مثل `Payments|Billing`).
# فارغًا ⟵ النطاق يُعلَن N/A ولا يُحسب نجاحًا.
: "${COVERAGE_FINANCIAL_MIN:=90}"
: "${COVERAGE_FINANCIAL_MODULES:=}"
# الواجهة — تُعلَن N/A ما لم تُوصَل أداة تغطية بـVitest.
: "${COVERAGE_FRONTEND_MIN:=60}"

# ── الحدود المعمارية (arch-check.sh) ─────────────────────────────────────────
# خريطة الموديولات: كود · مجلد توثيق · مجلد كود · بادئة جدول (TSV).
: "${MODULES_TSV:=scripts/config/modules.tsv}"
# فضاء أسماء الموديولات في الكود (شرطة مائلة عكسية واحدة بين المقاطع).
: "${MODULES_NAMESPACE:=App\\Modules}"
# فضاء العقود العابرة — الطريق الوحيد بين الموديولات (RS-020 · RS-023).
: "${SHARED_CONTRACTS_NS:=App\\Shared\\Contracts}"
# صنف الاستجابة المشترك الذي يستعمله هيكل المتحكم في scaffold-slice.sh.
: "${SHARED_API_RESPONSE_CLASS:=App\\Shared\\Http\\ApiResponse}"
# بادئات جداول (بحروف صغيرة) يُسمح لموديولاتها بإنشاء جداول **بلا بادئة** —
# الاستثناء الموثَّق لجداول مرجعية عامة. فارغًا ⟵ لا استثناء.
: "${UNPREFIXED_TABLE_MODULES:=}"
# بادئة هجرات إطار العمل نفسه (jobs · cache · sessions) التي لا يملكها موديول.
: "${FRAMEWORK_MIGRATION_PREFIX:=0001_01_01_}"
# استثناءات فحص `float` في سياق مالي (ERE) — أسماء لا تحمل مبلغًا.
: "${FLOAT_ALLOWLIST_REGEX:=min_value|max_value|typedValue|decimal}"
# خطوط أساس دَين انحراف الإصدارات (ملف لكل شقّ، سطر لكل ملف) — تتقلّص ولا تتوسع.
: "${DOC_VERSION_BASELINE_FILE:=scripts/config/doc-version-baseline.txt}"
: "${DOC_LAST_UPDATED_BASELINE_FILE:=scripts/config/doc-last-updated-baseline.txt}"
# صفوف جداول المتتبع المختلّة المسموح بها — دَين مقيس يتناقص ولا يُرفع بلا قرار.
: "${TRACKER_MALFORMED_ROWS_BASELINE:=0}"

# ── الختم والحماية والأسرار ──────────────────────────────────────────────────
# العلامة النائبة التي تتركها الوثائق لبصمة الالتزام ويستبدلها stamp-commit.sh.
: "${STAMP_PLACEHOLDER:=__COMMIT__}"
# أنماط المسارات المحمية (glob لكل سطر) التي لا تتغيّر بلا Change Request.
: "${PROTECTED_PATHS_FILE:=scripts/config/protected-paths.txt}"
# نمط (ERE) معرّف Change Request الذي يُبحث عنه في رسائل الالتزام.
# (الافتراضي في متغيّر مساعد لأن `}` داخل `${VAR:=…}` تُغلق التوسيع قبل أوانه.)
_shift_cr_default='CR-[0-9]{3,}'
: "${CHANGE_REQUEST_PATTERN:=$_shift_cr_default}"
unset _shift_cr_default
# مسارات تُستثنى من كاشف الأسرار (globs مفصولة بمسافات) — قوالب وأمثلة ووثائق.
: "${SECRET_SCAN_EXCLUDE_GLOBS:=*.env.example docs/** *.md}"
